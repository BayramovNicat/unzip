{
  "name": "unzip",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["packages/*"],
  "dependencies": {
    "@holmityd/unzip": "workspace:*"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run --cwd packages/unzip build && tsc && vite build",
    "bench": "bun run --cwd packages/unzip build && bun run benchmarks/unzip.bench.ts",
    "test": "bun run --cwd packages/unzip build && bun test",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@holmityd/litcode": "^0.1.5",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
