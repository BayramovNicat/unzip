{
  "name": "@holmityd/unzip",
  "version": "0.1.1",
  "description": "A tiny TypeScript ZIP reader for browsers and backend runtimes.",
  "type": "module",
  "license": "MIT",
  "author": "Nicat Bayramov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BayramovNicat/unzip.git",
    "directory": "packages/unzip"
  },
  "bugs": {
    "url": "https://github.com/BayramovNicat/unzip/issues"
  },
  "homepage": "https://github.com/BayramovNicat/unzip#readme",
  "keywords": [
    "zip",
    "unzip",
    "archive",
    "decompression",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  }
